<!--
  The Windows installer (WiX v5), built by tools/msi.sh. Installs the game, its assets folder
  beside it (where the game looks for it) and README.md into Program Files\Neon Lasertag, with a
  Start menu shortcut. Settings live in %APPDATA%\lasertag and are kept on uninstall.

  Bind paths: bin (the folder holding neon-lasertag.exe), assets, root (the repository).
  Variables: Version (numeric, x.y.z).
  The UpgradeCode never changes: a new installer replaces the installed version, the same
  version included (every CI build of a branch has the crate's version).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Neon Lasertag" Manufacturer="dividebysandwich" Version="$(Version)"
           UpgradeCode="4db247d8-8952-454b-83ce-d6bb61152092" Scope="perMachine">
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="lasertag.ico" SourceFile="!(bindpath.root)\packaging\windows\lasertag.ico" />
    <Property Id="ARPPRODUCTICON" Value="lasertag.ico" />

    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Neon Lasertag">
        <Component>
          <File Id="neon_lasertag.exe" Source="!(bindpath.bin)\neon-lasertag.exe" KeyPath="yes">
            <Shortcut Id="StartMenuShortcut" Name="Neon Lasertag" Directory="ProgramMenuFolder"
                      WorkingDirectory="INSTALLFOLDER" Icon="lasertag.ico" Advertise="yes" />
          </File>
        </Component>
        <Component>
          <File Source="!(bindpath.root)\README.md" />
        </Component>
        <Directory Id="ASSETS" Name="assets">
          <Files Include="!(bindpath.assets)\**" />
        </Directory>
      </Directory>
    </StandardDirectory>
  </Package>
</Wix>
